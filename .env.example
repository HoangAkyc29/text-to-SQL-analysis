# Supermarket — production template (copy → .env and fill blanks)
# Ports: docs/PORTS.md | Dev overrides: .env.dev.example

# --- LLM ---
OPENROUTER_API_KEY=
ALLOW_LLM_STUB=0

# --- Infra (Docker: docker compose pull redis mongodb && docker compose up -d) ---
REDIS_URL=redis://localhost:18379/0
MONGODB_URI=mongodb://localhost:18217/supermarket_agent

# --- Service URLs (host / reverse-proxy; compose overrides internal DNS) ---
SQL_GATEWAY_URL=http://localhost:18101
AGENT_I_URL=http://localhost:18201
AGENT_II_URL=http://localhost:18202
AGENT_III_URL=http://localhost:18203
AGENT_IV_URL=http://localhost:18204
CHAT_GATEWAY_URL=http://localhost:18300
FRONTEND_URL=http://localhost:13000

# --- Business SQL (readonly ×2) ---
ANALYTICS_DB_DSN=
ANALYTICS_DB_DSN_2=

# --- Auth SQL (username/password — POST /auth/login) ---
# Docker: container tới SQL Server trên host qua host.docker.internal (KHÔNG dùng localhost).
AUTH_DB_DSN=Driver={ODBC Driver 18 for SQL Server};Server=host.docker.internal,14330;Database=supermarket_auth;Uid=authapp;Pwd=CHANGE_ME;TrustServerCertificate=yes;

# --- JWT (cấp sau khi login username/password thành công) ---
JWT_SECRET=
REQUIRE_PROD_AUTH=1
ALLOW_DEV_AUTH=0

# --- Service-to-service (gateway ↔ agents ↔ sql-gateway) ---
REQUIRE_INTERNAL_AUTH=1
INTERNAL_SERVICE_TOKEN=

# --- OAuth Azure: KHÔNG CẦN nếu chỉ dùng user/pass trong AUTH_DB ---
# Chỉ bật khi muốn đăng nhập Microsoft 365 / SSO doanh nghiệp:
# OAUTH_PROVIDER=azure
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=https://your-domain/auth/callback
# AZURE_TENANT_ID=

PLATFORM_TRANSPORT=http

# --- Seed user passwords (set BEFORE running scripts/init_auth_db.py) ---
# If unset, bootstrap defaults are used (dev only) — rotate before prod.
# AUTH_SEED_STORE_MANAGER_PASSWORD=
# AUTH_SEED_HQ_ANALYST_PASSWORD=
# AUTH_SEED_ADMIN_PASSWORD=

# --- Tuning (defaults shown; set explicitly for prod) ---
# LOG_LEVEL=INFO
# AUTH_PERMISSIONS_CACHE_TTL=60          # seconds; per-process permission cache
# SANDBOX_MAX_ROWS=200000                # Agent IV dataframe row cap
# SANDBOX_MAX_SECONDS=30                 # Agent IV subprocess timeout
# SQL_GATEWAY_MAX_CONCURRENT=8           # sql-gateway concurrent query limit
# MONGODB_CONNECT_TIMEOUT_MS=2000
# SQL_AUDIT_LOG_PATH=data/state/audit.jsonl   # persist via a volume
# LIVE_TRIAL_LOG_DIR=data/state/live-trials   # append-only JSONL per analysis_id (Docker: /app/data/state/live-trials)
# ANALYSIS_QUEUE_STREAM=analysis:jobs
# ANALYSIS_QUEUE_GROUP=analysis-workers
# ANALYSIS_WORKER_CONSUMER=worker-1
# ANALYSIS_LEASE_SECONDS=90
# ANALYSIS_HEARTBEAT_SECONDS=20
# ANALYSIS_MAX_RETRIES=3
# ANALYSIS_EVENT_RETENTION_DAYS=30
# ANALYSIS_SSE_HEARTBEAT_SECONDS=15
# FRONTEND_ORIGIN=http://localhost:13000

# --- Redis / Mongo auth (used ONLY by docker-compose.prod.yaml) ---
# Base compose runs Redis/Mongo without auth; the prod overlay injects these.
# Mongo root creds only apply on a FRESH mongo data volume.
REDIS_PASSWORD=
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# --- Public TLS (Caddy reverse proxy in the prod overlay) ---
# localhost -> local self-signed cert (offline). A real domain -> Let's Encrypt
# (needs public DNS + ports 80/443 + a valid TLS_EMAIL).
PUBLIC_DOMAIN=localhost
TLS_EMAIL=admin@example.com

# Do NOT set in production:
# ALLOW_DEV_AUTH=1
# SQL_GATEWAY_INPROCESS=1
# ALLOW_LLM_STUB=1
