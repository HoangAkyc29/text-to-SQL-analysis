# Supermarket multi-agent environment

OPENROUTER_API_KEY=
REDIS_URL=redis://localhost:6379/0
MONGODB_URI=mongodb://localhost:27017/supermarket_agent

SQL_GATEWAY_URL=http://localhost:8101
AGENT_I_URL=http://localhost:8201
AGENT_II_URL=http://localhost:8202
AGENT_III_URL=http://localhost:8203
AGENT_IV_URL=http://localhost:8204
CHAT_GATEWAY_URL=http://localhost:8300

# Hai SQL Server readonly cho dữ liệu kinh doanh (sql-gateway route theo target_db: db1 | db2)
ANALYTICS_DB_DSN=
ANALYTICS_DB_DSN_2=

# Auth — không dùng cho query kinh doanh
AUTH_DB_DSN=Driver={ODBC Driver 18 for SQL Server};Server=localhost,1435;Database=supermarket_auth;Uid=sa;Pwd=YourStrong!Passw0rd;TrustServerCertificate=yes;

JWT_SECRET=change-me-in-production
# Production: set a strong random JWT_SECRET; rotate periodically.
REQUIRE_PROD_AUTH=0
REQUIRE_INTERNAL_AUTH=0
INTERNAL_SERVICE_TOKEN=
# Set INTERNAL_SERVICE_TOKEN + REQUIRE_INTERNAL_AUTH=1 for agent/sql-gateway HTTP auth.
# SQL_GATEWAY_INPROCESS=1 enables in-process sql tools (local dev only; Docker uses HTTP).
# MCP SSE entrypoint: uv run sql-gateway | HTTP (default Docker): uv run sql-gateway-http
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Azure AD / OAuth: configure OAUTH_* for production login; dev uses ALLOW_DEV_AUTH=1 on gateway.
ALLOW_LLM_STUB=0
PLATFORM_TRANSPORT=http
CASE_STUDY_SCOPE=global
