# Local dev overrides — merge into .env or copy sections (do not use in production)
# Alternative: keep prod auth flags and use POST /auth/login with seed users (deploy/sql/auth/)

ALLOW_DEV_AUTH=1
REQUIRE_PROD_AUTH=0
REQUIRE_INTERNAL_AUTH=0
INTERNAL_SERVICE_TOKEN=
ALLOW_LLM_STUB=1
OAUTH_PROVIDER=local
# SQL_GATEWAY_INPROCESS=1
