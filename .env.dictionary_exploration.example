# Dictionary / column exploration — LOCAL dev only (copy → .env.dictionary_exploration)
# Agents and sql-gateway use ANALYTICS_DB_DSN in .env (often host.docker.internal in Docker).
# Explore scripts NEVER read ANALYTICS_DB_DSN — only this file.

DICTIONARY_EXPLORE_UID=analysisagentreadonly
DICTIONARY_EXPLORE_PWD=CHANGE_ME

# Optional: full ODBC override per database (if set, ignores local.server in config/dictionary_exploration.yaml)
# DICTIONARY_EXPLORE_DB1_DSN=Driver={ODBC Driver 18 for SQL Server};Server=DESKTOP-AUQEDC5;Database=RESTORED_DB;Uid=analysisagentreadonly;Pwd=CHANGE_ME;TrustServerCertificate=yes;
# DICTIONARY_EXPLORE_DB2_DSN=Driver={ODBC Driver 18 for SQL Server};Server=DESKTOP-AUQEDC5;Database=RESTORED_DB2;Uid=analysisagentreadonly;Pwd=CHANGE_ME;TrustServerCertificate=yes;
