# Native Flet app on Windows host — SQL Server machine name (not host.docker.internal).
ANALYTICS_DB_DSN=Driver={ODBC Driver 18 for SQL Server};Server=DESKTOP-AUQEDC5;Database=RESTORED_DB;Uid=analysisagentreadonly;Pwd=CHANGE_ME;TrustServerCertificate=yes;
ANALYTICS_DB_DSN_2=Driver={ODBC Driver 18 for SQL Server};Server=DESKTOP-AUQEDC5;Database=RESTORED_DB2;Uid=analysisagentreadonly;Pwd=CHANGE_ME;TrustServerCertificate=yes;

# Optional override (defaults to DESKTOP-AUQEDC5 in code if unset)
DATA_ACCESS_SQL_SERVER=DESKTOP-AUQEDC5

DATA_ACCESS_OUTPUT_DIR=
DATA_ACCESS_QUERY_TIMEOUT=120
DATA_ACCESS_ROW_WARN=200000
# TOP cap for master search (SKU / CSCARD). UI warns when hit.
DATA_ACCESS_SEARCH_LIMIT=500000
